<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Line.Framework</PackageId>
    <Version>1.0.1</Version>
    <Authors>SmellyFish</Authors>
    <Description>A Game Framework</Description>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FontStashSharp" Version="1.3.10" />
    <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="ppy.osu.Framework.NativeLibs" Version="1.0.0" />
    <PackageReference Include="sdl2" Version="2.0.5" />
    <PackageReference Include="SDL2-CS" Version="2.0.0" />
    <PackageReference Include="SharpFont" Version="4.0.1" />
    <PackageReference Include="SharpText.Core" Version="0.3.1" />
    <PackageReference Include="SharpText.Veldrid" Version="0.3.1" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Veldrid" Version="4.9.0" />
    <PackageReference Include="Veldrid.ImageSharp" Version="4.9.0" />
    <PackageReference Include="Veldrid.SDL2" Version="4.9.0" />
    <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />
    <PackageReference Include="Veldrid.StartupUtilities" Version="4.9.0" />
    <PackageReference Include="Veldrid.Utilities" Version="4.9.0" />
  </ItemGroup>
</Project>
