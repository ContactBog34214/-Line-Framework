<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Line.Framework</PackageId>
    <AssemblyName>Line.Framework</AssemblyName>
    <Version>2026.117.0</Version>
    <Authors>SmellyFish</Authors>
    <Description>A Game Framework</Description>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedBass" Version="4.1.0-prerelease" />
    <PackageReference Include="ManagedBass.Fx" Version="4.1.0-prerelease" />
    <PackageReference Include="ppy.osu.Framework.NativeLibs" Version="2025.806.0-nativelibs" />
    <PackageReference Include="SDL3-CS" Version="3.4.16.1" />
    <PackageReference Include="SDL3-CS.Android" Version="3.4.16" />
    <PackageReference Include="SDL3-CS.iOS" Version="3.4.16" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.16" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.16" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.16" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>
</Project>
